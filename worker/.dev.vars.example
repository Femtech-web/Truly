# Server-only development configuration. Never commit real credentials.
# Operator-only; node scripts/creator-review.mjs setup-local creates a local key.
CREATOR_REVIEW_TOKEN=
# Server-owned comma-separated Nimiq reviewer identities; empty means no wallet admins.
REVIEWER_WALLETS=
AI_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=
GROQ_DATA_CONTROLS_CONFIRMED=false
AI_DAILY_LIMIT=100
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAIRING_ORIGIN=http://localhost:5173
# Phase 6: keep disabled until seller/price and trusted RPC are configured.
NIM_PAYMENTS_ENABLED=false
NIM_RPC_URL=
NIM_PAYMENT_RECIPIENT=
USDT_PAYMENTS_ENABLED=false
USDT_MAINNET_APPROVED=false
POLYGON_RPC_URL=
USDT_PAYMENT_RECIPIENT=
